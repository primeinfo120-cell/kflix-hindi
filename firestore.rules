
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "8UAvXycR7VbQnivvD5kjeyBMAmq2";
    }

    function validUrl(value) {
      return value is string
        && value.size() <= 2048
        && (value == "" || value.matches("^https?://.+"));
    }

    function validDrama(data) {
      return data.keys().hasAll([
          "title", "slug", "posterUrl", "backdropUrl", "description",
          "releaseYear", "genre", "language", "status", "publicationStatus",
          "createdAt", "updatedAt"
        ])
        && data.keys().hasOnly([
          "title", "slug", "posterUrl", "backdropUrl", "description",
          "releaseYear", "genre", "language", "status", "publicationStatus",
          "createdAt", "updatedAt"
        ])
        && data.title is string && data.title.size() > 0 && data.title.size() <= 160
        && data.slug is string && data.slug.size() <= 120 && data.slug.matches("^[a-z0-9]+(-[a-z0-9]+)*$")
        && validUrl(data.posterUrl) && data.posterUrl != ""
        && validUrl(data.backdropUrl)
        && data.description is string && data.description.size() <= 5000
        && data.releaseYear is int && data.releaseYear >= 1900 && data.releaseYear <= 2100
        && data.genre is string && data.genre.size() > 0 && data.genre.size() <= 80
        && data.language is string && data.language.size() > 0 && data.language.size() <= 100
        && data.status in ["ongoing", "completed"]
        && data.publicationStatus in ["draft", "published"]
        && data.createdAt is timestamp && data.updatedAt is timestamp;
    }

   
function validEpisode(data) {
  return data.keys().hasAll([
      "dramaId", "dramaPublicationStatus", "episodeNumber",
      "description", "videoUrl", "thumbnailUrl",
      "publicationStatus", "createdAt", "updatedAt"
    ])
    && data.keys().hasOnly([
      "dramaId", "dramaPublicationStatus", "episodeNumber",
      "title", "description", "videoUrl", "thumbnailUrl",
      "publicationStatus", "createdAt", "updatedAt"
    ])
    && data.dramaId is string && data.dramaId.size() > 0
    && data.dramaPublicationStatus in ["draft", "published"]
    && data.episodeNumber is int && data.episodeNumber > 0
    && (!("title" in data) ||
        (data.title is string && data.title.size() <= 160))
    && data.description is string && data.description.size() <= 3000
    && validUrl(data.videoUrl) && data.videoUrl != ""
    && validUrl(data.thumbnailUrl)
    && data.publicationStatus in ["draft", "published"]
    && data.createdAt is timestamp && data.updatedAt is timestamp
    && exists(/databases/$(database)/documents/dramas/$(data.dramaId));
}

    function publishedDrama(dramaId) {
      return exists(/databases/$(database)/documents/dramas/$(dramaId))
        && get(/databases/$(database)/documents/dramas/$(dramaId)).data.publicationStatus == "published";
    }

    function validReview(data) {
      return data.keys().hasAll([
          "uid", "displayName", "rating", "comment", "createdAt", "updatedAt"
        ])
        && data.keys().hasOnly([
          "uid", "displayName", "rating", "comment", "createdAt", "updatedAt"
        ])
        && data.uid is string
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 60
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.comment is string
        && data.comment.size() <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /dramas/{dramaId} {
      allow get, list: if isAdmin() || resource.data.publicationStatus == "published";

      allow create: if isAdmin()
        && validDrama(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && validDrama(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /episodes/{episodeId} {
      allow get, list: if isAdmin() || publishedEpisode();

      allow create: if isAdmin()
        && validEpisode(request.resource.data)
        && getAfter(/databases/$(database)/documents/dramas/$(request.resource.data.dramaId)).data.publicationStatus == request.resource.data.dramaPublicationStatus
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if isAdmin()
        && validEpisode(request.resource.data)
        && (
          request.resource.data.dramaPublicationStatus == "draft"
          || getAfter(/databases/$(database)/documents/dramas/$(request.resource.data.dramaId)).data.publicationStatus == request.resource.data.dramaPublicationStatus
        )
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin();
    }

    match /dramas/{dramaId}/reviews/{reviewId} {
      allow read: if isAdmin() || publishedDrama(dramaId);

      allow create: if request.auth != null
        && publishedDrama(dramaId)
        && reviewId == request.auth.uid
        && validReview(request.resource.data)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow update: if request.auth != null
        && publishedDrama(dramaId)
        && reviewId == request.auth.uid
        && validReview(request.resource.data)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time;

      allow delete: if isAdmin()
        || (request.auth != null && reviewId == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
